# ---------------------------------------------------------------------------
# Contact form email (Hostinger SMTP)
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored — never commit real credentials, and never prefix any of these
# with NEXT_PUBLIC_ (that would ship them to the browser).
#
# Find the values in hPanel -> Emails -> business@tekvion.net ->
# "Connect Apps & Devices" -> Manual configuration.
# ---------------------------------------------------------------------------

# Hostinger's outgoing mail server. Usually smtp.hostinger.com — confirm in hPanel.
SMTP_HOST=smtp.hostinger.com

# 465 for implicit SSL/TLS (recommended), or 587 for STARTTLS.
SMTP_PORT=465

# Optional. Defaults to true when the port is 465, false otherwise.
# SMTP_SECURE=true

# The full mailbox address — this is also the SMTP username.
SMTP_USER=business@tekvion.net

# The mailbox password. If you would rather not reuse the login password,
# create a dedicated sending mailbox in hPanel and use that instead.
#
# ALWAYS wrap it in single quotes. Unquoted, a '#' starts a comment and
# everything after it is silently discarded — which looks exactly like a wrong
# password (SMTP replies "535 authentication failed"). Single quotes also stop
# '$' being read as a variable and preserve any trailing spaces.
#   SMTP_PASS='pa#ssw0rd$x'
# The same applies when setting this on the server: quote it in your pm2
# ecosystem file, systemd unit or Hostinger env panel.
SMTP_PASS=''

# Where enquiry notifications are delivered. Defaults to SMTP_USER.
# Accepts a comma-separated list if more than one person should be notified.
# CONTACT_TO=business@tekvion.net

# Display name on the From header of both emails.
SMTP_FROM_NAME=Tekvion Innovations

# Booking link used in the automated reply. Falls back to the hard-coded
# Calendly URL if unset.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/tekvion-innovations/30min
